{
  "name": "note-studio-mvp",
  "private": true,
  "version": "0.1.0",
  "description": "本地文档转换与 PDF 编辑工具",
  "author": "Note Studio Contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "convert": "python server/convert_server.py --port 5198",
    "electron:dev": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win portable",
    "android:build": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "android:build:release": "npm run build && npx cap sync android && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "docx": "^9.7.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "marked": "^14.1.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vosk-browser": "^0.0.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "36.4.0",
    "electron-builder": "26.0.12",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.notestudio.app",
    "productName": "Note Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Note-Studio-${version}-Windows.exe"
    }
  }
}